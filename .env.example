# URL base da API do CRM, lida só no servidor (nunca vai ao navegador)
CRM_URL=
# Chave do catálogo, enviada no cabeçalho x-catalog-key ao ler os itens do CRM
CATALOG_KEY=
# Segredo comparado com o Authorization: Bearer enviado pelo CRM em POST /api/revalidate
SITE_REVALIDATE_SECRET=
# URL pública do site, usada em metadata, sitemap e dados estruturados
SITE_URL=
# Razão social exibida na página /privacidade
EMPRESA_RAZAO_SOCIAL=
# CNPJ exibido na página /privacidade
EMPRESA_CNPJ=
# E-mail do encarregado (LGPD) exibido na página /privacidade
EMPRESA_EMAIL_ENCARREGADO=
# Opcional: hosts extras (só o nome, separados por vírgula) de onde a rota /imagens pode buscar
# foto, além do armazenamento do Bling e do próprio CRM — ex.: foto de kit hospedada em outro lugar
IMAGENS_HOSTS_EXTRAS=
# "1" mostra as páginas de vendas por linha marcadas como rascunho (lib/linhas/).
# Só desenvolvimento/e2e; nunca em produção.
MOSTRAR_RASCUNHOS=

# URL do CRM usada pelo navegador para falar com o webchat
NEXT_PUBLIC_CRM_URL=
# Chave pública do webchat, enviada no cabeçalho x-webchat-key ao abrir sessão
NEXT_PUBLIC_WEBCHAT_KEY=
# Site key do Cloudflare Turnstile, carregada pelo painel do chat
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Número de WhatsApp (só dígitos) usado no botão de contingência do chat
NEXT_PUBLIC_WHATSAPP_FALLBACK=
# Base pública do bucket site-midia: fotos e vídeos das páginas de vendas por linha
NEXT_PUBLIC_MIDIA_URL=
